# Auth Service env
AUTH_PORT=8081
AUTH_DB_DSN=postgres://postgres:postgres@postgres-auth:5432/auth_db?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
DEV_MODE=false
OTP_TTL=5m

# Shared JWT settings (must match api-gateway values)
JWT_SECRET=eGYwVzceKpNBxX3syAamuY8h7akWw6cKlyg9IYHAsF8
JWT_ISSUER=cloudbin-auth
JWT_ACCESS_TTL=24h

# SMTP — local dev: Mailpit captures all outgoing email (no real emails sent).
# Open http://localhost:8025 to view the inbox.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@cloudbin.local
SMTP_FROM_NAME=CloudBin

# Production SMTP example (uncomment and fill in):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-gmail-address@gmail.com
# SMTP_PASSWORD=your-smtp-app-password
# SMTP_FROM_EMAIL=your-gmail-address@gmail.com
