# Auth Service env
AUTH_PORT=8081
AUTH_DB_DSN=postgres://postgres:postgres@localhost:5432/auth_db?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
OTP_TTL=5m

# Shared JWT settings (must match api-gateway values)
JWT_SECRET=change-me
JWT_ISSUER=cloudbin-auth
JWT_ACCESS_TTL=24h

# Email settings (Brevo SMTP)
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=your-smtp-login
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@cloudbin.local
SMTP_FROM_NAME=CloudBin

# Backward compatibility fallbacks (optional)
SMTP_HOST=
SMTP_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=