# CloudBin Docker Compose env

# Core service URLs used by Docker Compose
GATEWAY_PORT=8080
AUTH_SERVICE_URL=http://auth-service:8081
OBJECT_API_URL=http://object-api:8082

# Auth service
AUTH_PORT=8081
AUTH_DB_DSN=postgres://postgres:postgres@postgres-auth:5432/auth_db?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
DEV_MODE=false
OTP_TTL=5m
JWT_SECRET=eGYwVzceKpNBxX3syAamuY8h7akWw6cKlyg9IYHAsF8
JWT_ISSUER=cloudbin-auth
JWT_ACCESS_TTL=24h
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=paranie.notifications@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=paranie.notifications@gmail.com
SMTP_FROM_NAME=CloudBin

# Object API
OBJECT_API_PORT=8082
OBJECT_DB_DSN=postgres://postgres:postgres@postgres-object:5432/object_db?sslmode=disable
STORAGE_NODES=http://storage-node-1:8083,http://storage-node-2:8083,http://storage-node-3:8083
REPLICATION_FACTOR=2

# Storage node defaults
STORAGE_PORT=8083
STORAGE_ROOT=/data

# Optional auth seed values
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=admin123
USER_EMAIL=user@example.com
USER_INITIAL_PASSWORD=user123